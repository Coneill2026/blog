---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Cian's Wonderful blog !</h1>
			<p>
				Welcome to Cians Wonderful blog! This is a personal blog where I share my thoughts,
				experiences, and insights on various topics that interest me. From technology and programming
				to travel and playing guitar, you'll find a diverse range of content here.
				I hope you enjoy reading my posts and feel free to leave comments
				or reach out if you have any questions or suggestions!
			</p>
			<img
				src="https://thumb.wikimedia.org/wikipedia/commons/thumb/8/85/Smiley.svg/960px-Smiley.svg.png?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail"
				alt="Placeholder blog image"
				style="display:block; width:100%; max-width:1200px; height:auto; margin:2rem auto 0; border-radius:12px;"
			/>
